# ==================== MAIN ====================

main() {
    # Ensure log directory exists (silently fail if not root)
    install -d -m 755 "$(dirname "$LOG_FILE")" 2>/dev/null || true
    touch "$LOG_FILE" 2>/dev/null || true
    
    local command="${1:-help}"
    shift || true
    
    case "$command" in
        add|create|new)
            cmd_add "$@"
            ;;
        remove|delete|rm)
            cmd_remove "$@"
            ;;
        list|ls)
            cmd_list "$@"
            ;;
        status|info)
            cmd_status "$@"
            ;;
        install|setup)
            cmd_install "$@"
            ;;
        help|--help|-h)
            cmd_help
            ;;
        version|--version|-v)
            echo "sitectl v${VERSION}"
            ;;
        *)
            error "Unknown command: $command"
            echo "Run 'sitectl help' for usage information."
            exit 1
            ;;
    esac
}

main "$@"
